{
  "id": "/",
  "name": "QuranMotion",
  "short_name": "QuranMotion",
  "description": "Read the full Madinah mushaf and turn pages hands free: wave your hand, say \"next\", or read aloud and the page follows you.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FDF6E3",
  "theme_color": "#0B5546",
  "lang": "en",
  "dir": "ltr",
  "categories": ["books", "education", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "icons/screens/phone-1-page.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "The full Madinah mushaf page" },
    { "src": "icons/screens/phone-2-fatiha.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Al-Faatiha" },
    { "src": "icons/screens/phone-3-recite.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Read aloud and the ayah you read lights up" },
    { "src": "icons/screens/phone-4-home.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Surahs, juz and bookmarks" },
    { "src": "icons/screens/phone-5-translation.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Translation under each ayah" },
    { "src": "icons/screens/phone-6-night.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Night page colour" },
    { "src": "icons/screens/wide-1-tablet.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Tablet in landscape" }
  ],
  "shortcuts": [
    { "name": "Continue reading", "url": "./index.html#read", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
